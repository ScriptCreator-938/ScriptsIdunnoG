-- [[ HELPER FUNCTIONS ]]
local function isCriminal(player)
    if not player.Team then return false end
    local criminalColors = { ["Slime green"] = true, ["Neon orange"] = true, ["Dusty Rose"] = true, ["Plum"] = true, ["Dark stone grey"] = true }
    return criminalColors[player.TeamColor.Name] or string.find(string.lower(player.Team.Name), "criminal") ~= nil
end

local function isInnocent(player)
    local svVars = player:FindFirstChild("ServerVariables")
    if svVars then
        local innocentVal = svVars:FindFirstChild("Innocent")
        if innocentVal and innocentVal:IsA("ValueBase") then 
            return innocentVal.Value == true 
        end
    end
    return false
end

local function isDangerous(player)
    local char = player.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and table.find(dangerousItems, tool.Name) then return true end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do 
            if table.find(dangerousItems, item.Name) then return true end 
        end
    end
    return false
end

-- [[ STORAGE FOR ESP ]]
local EspStorage = {}

local function createEspForPlayer(player)
    if player == LocalPlayer then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight_" .. player.Name
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Text_" .. player.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)

    local textLabel = Instance.new("TextLabel", billboard)
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 13
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextStrokeTransparency = 0

    EspStorage[player] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = textLabel
    }
end

local function removeEsp(player)
    if EspStorage[player] then
        if EspStorage[player].Highlight then EspStorage[player].Highlight:Destroy() end
        if EspStorage[player].Billboard then EspStorage[player].Billboard:Destroy() end
        EspStorage[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do createEspForPlayer(p) end
Players.PlayerAdded:Connect(createEspForPlayer)
Players.PlayerRemoving:Connect(removeEsp)

-- [[ UPDATE ESP LOOP ]]
RunService.RenderStepped:Connect(function()
    for player, esp in pairs(EspStorage) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")

        if not Settings.EspEnabled or not char or not hrp or not hum or hum.Health <= 0 then
            esp.Highlight.Parent = nil
            esp.Billboard.Parent = nil
            continue
        end

        local isCrim = isCriminal(player)
        local innocentStatus = isInnocent(player)
        local dangerousStatus = isDangerous(player)

        -- Highlight Chams (Giữ ESP cho TẤT CẢ người chơi, không bị Filter làm ẩn)
        esp.Highlight.Parent = char
        local teamColor = player.TeamColor and player.TeamColor.Color or Color3.fromRGB(255, 255, 255)
        
        esp.Highlight.OutlineColor = teamColor
        esp.Highlight.OutlineTransparency = Settings.EspOutline and 0 or 1
        
        esp.Highlight.FillColor = teamColor
        esp.Highlight.FillTransparency = Settings.EspFill and (1 - Settings.FillDensity) or 1

        -- Billboard Text
        esp.Billboard.Parent = game.CoreGui
        esp.Billboard.Adornee = hrp

        local textLines = {}

        -- Filter Status (Chỉ chèn thêm cảnh báo chứ không ẩn ESP)
        if isCrim then
            if Settings.FilterInnocent and not innocentStatus then
                table.insert(textLines, "❗️ Non-Innocent")
            end
            if Settings.FilterDangerous and dangerousStatus then
                table.insert(textLines, "⚠️ Dangerous")
            end
        end

        if Settings.ShowName then
            table.insert(textLines, string.format("%s (@%s)", player.DisplayName, player.Name))
        end

        if Settings.EspTeam then
            local teamName = player.Team and player.Team.Name or "No Team"
            table.insert(textLines, "[" .. teamName .. "]")
        end

        if Settings.ShowHealthStuds then
            local dist = math.floor((Cam.CFrame.Position - hrp.Position).Magnitude)
            local hp = math.floor(hum.Health)
            table.insert(textLines, string.format("HP: %d | %d Studs", hp, dist))
        end

        esp.Label.Text = table.concat(textLines, "\n")
        esp.Label.TextColor3 = teamColor
    end
end)

