----------------------------------------------------------------
-- 3. LOGIC XỬ LÝ SÚNG CHỦ ĐỘNG
----------------------------------------------------------------
local function applyFiremode(tool, value)
    if not tool or not value then return end
    local vars = tool:FindFirstChild("Variables")
    if vars then
        local cfm = vars:FindFirstChild("CurFiremode")
        if cfm then
            cfm.Value = value
            WeaponHistory[tool.Name] = value -- Lưu lịch sử để cứu khi chết
        end
    end
end

local function manualChangeFiremode(targetValue)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")

    if ModMode == "Mod Equiping" then
        if char then
            local t = char:FindFirstChildOfClass("Tool")
            if t then applyFiremode(t, targetValue) end
        end
    elseif ModMode == "Mod All" then
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then applyFiremode(t, targetValue) end
            end
        end
        if char then
            local t = char:FindFirstChildOfClass("Tool")
            if t then applyFiremode(t, targetValue) end
        end
    end
end

SemiBtn.MouseButton1Click:Connect(function() manualChangeFiremode("Semi") end)
AutoBtn.MouseButton1Click:Connect(function() manualChangeFiremode("Auto") end)
BurstBtn.MouseButton1Click:Connect(function() manualChangeFiremode("Burst") end)

ModeBtn.MouseButton1Click:Connect(function()
    if ModMode == "Mod Equiping" then
        ModMode = "Mod All"
        ModeText.Text = "MODE: ALL TOOLS"
        ModeGradient.Color = ColorSequence.new(Color3.fromRGB(0, 255, 150), Color3.fromRGB(0, 150, 255))
    else
        ModMode = "Mod Equiping"
        ModeText.Text = "MODE: EQUIPPING"
        ModeGradient.Color = ColorSequence.new(Color3.fromRGB(255, 85, 0), Color3.fromRGB(255, 170, 0))
    end
end)

-- LOGIC CỨU DỮ LIỆU KHI CHẾT (RESPAWN):
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.8)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and WeaponHistory[t.Name] then
                applyFiremode(t, WeaponHistory[t.Name])
            end
        end
    end
    local t = char:FindFirstChildOfClass("Tool")
    if t and WeaponHistory[t.Name] then
        applyFiremode(t, WeaponHistory[t.Name])
    end
end)

----------------------------------------------------------------
-- 4. KÉO THẢ VÀ ANIMATION TWEEN THU NHỎ
----------------------------------------------------------------
local dragToggle, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragToggle = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local Minimized = false
local TweenInfoUI = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

MinBtn.MouseButton1Click:Connect(function()
    Minimized = not Minimized
    
    local targetSize = Minimized and UDim2.new(0, 260, 0, 30) or UDim2.new(0, 260, 0, 260)
    MinBtn.Text = Minimized and "+" or "-"
    
    local ResizeTween = TweenService:Create(MainFrame, TweenInfoUI, {Size = targetSize})
    ResizeTween:Play()
end)

