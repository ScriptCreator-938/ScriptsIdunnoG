-- HÀM TẠO NÚT BẤM ĐẸP (Đã sửa lỗi tách Text)
local function createBeautifulBtn(name, color1, color2)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    b.Text = "" -- Không dùng text gốc của button để tránh lỗi mất chữ
    b.Parent = Btns
    
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new(color1, color2)
    grad.Parent = b
    
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    -- Tạo lớp TextLabel đè lên trên cùng để chữ luôn hiển thị rõ nét
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "SET " .. name:upper()
    label.Font = Enum.Font.SourceSansBold
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 14
    label.Parent = b
    
    return b
end

