task.spawn(function()
    while task.wait(0.2) do
        local toolName = "None"
        local fireVal = "Nil"
        local char = LocalPlayer.Character
        
        if char then
            local t = char:FindFirstChildOfClass("Tool")
            if t then
                toolName = t.Name
                local vars = t:FindFirstChild("Variables")
                if vars and vars:FindFirstChild("CurFiremode") then
                    fireVal = tostring(vars.CurFiremode.Value)
                end
            end
        end
        
        StatusLabel.Text = "Tool: ["..toolName.."]\nFiremode: ["..fireVal.."]"
    end
end)
