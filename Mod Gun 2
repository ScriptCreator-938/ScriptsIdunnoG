--- LOGIC QUÉT VŨ KHÍ CHẠY TRONG LUỒNG NGẦM RIÊNG ---

local function getFiremodeObject(tool)
	if tool and tool:FindFirstChild("Variables") then
		return tool.Variables:FindFirstChild("CurFiremode")
	end
	return nil
end

local function getEquippedTool()
	local char = LocalPlayer.Character
	if char then
		return char:FindFirstChildOfClass("Tool")
	end
	return nil
end

task.spawn(function()
	while task.wait(0.3) do
		pcall(function()
			local currentTool = getEquippedTool()
			if currentTool then
				local firemodeObj = getFiremodeObject(currentTool)
				local valStr = firemodeObj and tostring(firemodeObj.Value) or "Nil"
				StatusLabel.Text = "Tool: " .. currentTool.Name .. "\nFiremode: " .. valStr
			else
				StatusLabel.Text = "Tool: Không cầm\nFiremode: Nil"
			end
		end)
	end
end)

local function applyFiremode(targetValue)
	pcall(function()
		if modMode == "Equipping" then
			local tool = getEquippedTool()
			if tool then
				local firemodeObj = getFiremodeObject(tool)
				if firemodeObj then firemodeObj.Value = targetValue end
			end
		elseif modMode == "All" then
			local tool = getEquippedTool()
			if tool then
				local firemodeObj = getFiremodeObject(tool)
				if firemodeObj then firemodeObj.Value = targetValue end
			end
			local backpack = LocalPlayer:FindFirstChild("Backpack")
			if backpack then
				for _, bTool in ipairs(backpack:GetChildren()) do
					if bTool:IsA("Tool") then
						local firemodeObj = getFiremodeObject(bTool)
						if firemodeObj then firemodeObj.Value = targetValue end
					end
				end
			end
		end
	end)
end

BtnSemi.MouseButton1Click:Connect(function() applyFiremode("Semi") end)
BtnAuto.MouseButton1Click:Connect(function() applyFiremode("Auto") end)
BtnBurst.MouseButton1Click:Connect(function() applyFiremode("Burst") end)


--- TÍNH NĂNG THU NHỎ ---

local isMinimized = false
local originalSize = MainFrame.Size

MinBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		ContentContainer.Visible = false
		MinBtn.Text = "+"
		TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 320, 0, 40)}):Play()
	else
		MinBtn.Text = "-"
		TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = originalSize}):Play()
		task.wait(0.12)
		ContentContainer.Visible = true
	end
end)


--- HỆ THỐNG KÉO THẢ MƯỢT MÀ ---

local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then update(input) end
end)
