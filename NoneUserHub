-- Bấm YES -> Xóa GUI và EXECUTE script lập tức
btnYes.MouseButton1Click:Connect(function()
    if targetScriptUrl ~= "" then
        screenGui:Destroy()
        loadstring(game:HttpGet(targetScriptUrl))()
    end
end)

-- ==========================================
-- XỬ LÝ SỰ KIỆN CLICK NÚT SCRIPT
-- ==========================================

local SCRIPT_W1_URL = "https://raw.githubusercontent.com/ScriptCreator-938/ScriptsIdunnoG/main/TSS%20Script%20World%201"
local SCRIPT_W2_URL = "https://raw.githubusercontent.com/ScriptCreator-938/ScriptsIdunnoG/main/TSS%20Script%20World%202"

btnWorld1.MouseButton1Click:Connect(function()
    if currentPlaceId == WORLD_1_ID then
        -- Ở cùng World 1 -> Chạy trực tiếp
        screenGui:Destroy()
        loadstring(game:HttpGet(SCRIPT_W1_URL))()
    else
        -- Khác World -> Hiện bảng xác nhận, gán URL World 1 để Execute khi bấm Yes
        targetScriptUrl = SCRIPT_W1_URL
        confirmTitle.Text = "Are you sure you gonna execute\n" .. btnWorld1.Text .. "?"
        frame.Visible = false
        confirmFrame.Visible = true
    end
end)

btnWorld2.MouseButton1Click:Connect(function()
    if currentPlaceId == WORLD_2_ID or currentPlaceId ~= WORLD_1_ID then
        -- Ở cùng World 2 -> Chạy trực tiếp
        screenGui:Destroy()
        loadstring(game:HttpGet(SCRIPT_W2_URL))()
    else
        -- Khác World -> Hiện bảng xác nhận, gán URL World 2 để Execute khi bấm Yes
        targetScriptUrl = SCRIPT_W2_URL
        confirmTitle.Text = "Are you sure you gonna execute\n" .. btnWorld2.Text .. "?"
        frame.Visible = false
        confirmFrame.Visible = true
    end
end)
